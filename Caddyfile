{
	https_port 8443
	default_bind 127.0.0.1 172.30.87.3
	auto_https disable_redirects
	servers {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.1/32 172.30.87.1/32
				fallback_policy reject
			}
			tls
		}
	}
}

(bookio_proxy) {
	reverse_proxy {args[0]} {
		header_up X-Bookio-Client-IP {http.request.remote.host}
	}
}

bookio.duckdns.org {
	tls {
		issuer acme {$ACME_CA} {
			email {$ACME_EMAIL}
			disable_http_challenge
		}
	}
	import bookio_proxy bookio-backend:8080
}

staging.bookio.duckdns.org {
	tls {
		issuer acme {$ACME_STAGING_CA} {
			email {$ACME_EMAIL}
			disable_http_challenge
		}
	}
	import bookio_proxy bookio-staging-backend:8080
}
